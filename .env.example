# Copy this file to .env and fill in your values.

# Which LLM backend to use: groq | ollama | mock
#   groq   -> free cloud API, fastest to set up (get a key at https://console.groq.com/keys)
#   ollama -> runs an open-source model on your own laptop (install from https://ollama.com)
#   mock   -> no LLM at all, returns a canned reply (for testing the app offline)
LLM_PROVIDER=groq

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
# Open-weight model hosted on Groq. Run `python scripts/list_groq_models.py` to see current options.
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Generation settings ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# Output limit for business plan generation (long JSON answers)
PLAN_MAX_TOKENS=4096

# --- Phase 3: RAG ---
# Embedding model used to index data/docs (downloaded once, ~470 MB, runs on CPU).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Folder for the vector database (never commit it).
CHROMA_DIR=chroma_db
# Drop search results with a relevance score below this (0 to 1).
RAG_MIN_SCORE=0.25

# --- Phase 6: persistence ---
# SQLite file with sessions, plans, checklist and Q&A (delete it to reset all data).
DB_PATH=data/app.db
# sqlite (default, survives restarts) or memory (sessions are lost on restart)
SESSION_STORE=sqlite

# --- Phase 6: languages ---
DEFAULT_PLAN_VERSION=plan_v5
# auto = use TRANSLATE_MODE_MAP; or force "direct" / "pivot" for every language
TRANSLATE_MODE=auto
TRANSLATE_MODE_MAP=en:direct,hi:direct,bn:pivot,mr:pivot,ta:pivot,te:pivot,gu:pivot
