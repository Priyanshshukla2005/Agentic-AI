# Copy this file to .env and fill in your values (run.sh / run.bat do the copy for you).
# Every setting the app reads is listed here. Lines you leave out use the default shown.

# ===================== LLM =====================
# Which LLM backend to use: groq | ollama | mock
#   groq   -> free cloud API, fastest to set up (get a key at https://console.groq.com/keys)
#   ollama -> runs an open-source model on your own laptop (install from https://ollama.com)
#   mock   -> no LLM at all, fixed answers (for testing and offline demos)
LLM_PROVIDER=groq

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
# Open-weight model hosted on Groq. Run `python scripts/list_groq_models.py` to see current options.
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Generation settings ---
LLM_TEMPERATURE=0.3
# Output limit for short calls (intake questions, Q&A answers)
LLM_MAX_TOKENS=2048
# Output limit for business plan generation (long JSON answers)
PLAN_MAX_TOKENS=4096

# ===================== Scheme search (RAG) =====================
# Embedding model used to index data/docs (downloaded once, ~470 MB, runs on CPU).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Folder for the vector database (never commit it). Build it with: python scripts/ingest_docs.py
CHROMA_DIR=chroma_db
# Drop search results with a relevance score below this (0 to 1).
RAG_MIN_SCORE=0.25

# ===================== Storage =====================
# SQLite file with sessions, plans, checklist and Q&A. Delete it to reset all data.
DB_PATH=data/app.db
# sqlite (default, survives restarts) or memory (sessions are lost on restart)
SESSION_STORE=sqlite

# ===================== Plans and languages =====================
# Prompt version used when none is given: plan_v1 ... plan_v5
DEFAULT_PLAN_VERSION=plan_v5
# auto = use TRANSLATE_MODE_MAP per language; or force "direct" / "pivot" for every language
#   direct = the LLM writes in the user's language; pivot = writes in English, then translated
TRANSLATE_MODE=auto
TRANSLATE_MODE_MAP=en:direct,hi:direct,bn:pivot,mr:pivot,ta:pivot,te:pivot,gu:pivot
# Mock mode only: "valid" or "invalid" (a broken plan to demo repair + auto-fix)
MOCK_PLAN_VARIANT=valid

# ===================== Evaluation (scripts/run_eval.py) =====================
# Model used as the LLM judge (temperature 0). A different model family than GROQ_MODEL, such as
# llama-3.3-70b-versatile, reduces the risk of the judge favouring its own writing style.
JUDGE_MODEL=openai/gpt-oss-120b
# Seconds to wait between LLM calls (Groq free tier has per-minute limits)
EVAL_DELAY_SECONDS=2
# Retries with exponential backoff on 429 (rate limit) and 5xx errors
EVAL_MAX_RETRIES=5
